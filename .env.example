# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=replace-me
# Generate a long random value; Telegram sends it in the webhook header.
TELEGRAM_WEBHOOK_SECRET=replace-me-with-a-long-random-string
# Fixed Telegram-to-Google-Calendar mappings. Add user 2 only if needed.
TELEGRAM_USER_1_ID=123456789
TELEGRAM_USER_1_USERNAME=juzteeeen
GOOGLE_USER_1_REFRESH_TOKEN=replace-me
GOOGLE_USER_1_CALENDAR_ID=primary
TELEGRAM_USER_2_ID=
TELEGRAM_USER_2_USERNAME=
GOOGLE_USER_2_REFRESH_TOKEN=
GOOGLE_USER_2_CALENDAR_ID=primary
# The only private group/supergroup allowed to read either user's schedule.
TELEGRAM_GROUP_ID=

# From console.groq.com/keys
GROQ_API_KEY=replace-me
# Current Groq model used for reliable JSON extraction.
GROQ_MODEL=openai/gpt-oss-20b

# From Google Cloud OAuth Desktop app credentials. Each user authorizes this
# same client locally to obtain their own GOOGLE_USER_n_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# IANA timezone used to resolve phrases such as "tomorrow".
USER_TIMEZONE=Asia/Singapore
SCHEDULER_SECRET=replace-me-with-a-long-random-string
DAILY_AGENDA_HOUR=8
# cron-job.org Console → Settings → API keys. Required for independent reminders.
CRON_JOB_API_KEY=replace-me
# Public origin only, without a trailing slash.
SERVICE_BASE_URL=https://your-service.onrender.com

# Emit Python thread stacks if the process receives a fatal native signal.
PYTHONFAULTHANDLER=1
