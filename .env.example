# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=replace-me
# Generate a long random value; Telegram sends it in the webhook header.
TELEGRAM_WEBHOOK_SECRET=replace-me-with-a-long-random-string
# Numeric Telegram ID permitted to use this personal bot (e.g. 123456789)
ALLOWED_TELEGRAM_USER_ID=123456789

# From console.anthropic.com
ANTHROPIC_API_KEY=replace-me
# A cost-efficient supported Claude model. Change if this model is retired.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# From Google Cloud OAuth Desktop app credentials and the local auth script
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me
GOOGLE_CALENDAR_ID=primary

# IANA timezone used to resolve phrases such as "tomorrow".
USER_TIMEZONE=Asia/Singapore

